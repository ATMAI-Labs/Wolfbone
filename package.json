{
  "name": "wolfbone",
  "version": "0.1.0",
  "private": true,
  "description": "An open mathematical workspace. First medium: finite collections and functions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "markdownlint-cli2 && node scripts/check-content.mjs && git diff --check && git diff --cached --check",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/math/*.test.ts src/lib/workspace/*.test.ts src/lib/library/*.test.ts",
    "library:verify": "node scripts/import-mathlib.mjs --verify",
    "library:import": "node scripts/import-mathlib.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mjs components.json .prettierrc.json"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "markdown-it": "15.0.2",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  }
}
